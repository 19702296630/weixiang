# ============================================================
# 环境变量配置模板
# 使用方式：复制本文件为 .env 并填入真实值（.env 不要提交到 git）
#   cp .env.example .env
# ============================================================

# ===================== MySQL 数据库 =====================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=task_management
# 字符集务必用 utf8mb4，否则中文和 emoji 会乱码
DB_CHARSET=utf8mb4

# ---- 连接池（生产级，可选）----
# 连接池基础大小（常驻连接数）
DB_POOL_SIZE=10
# 超出 pool_size 后最多再创建的连接数
DB_MAX_OVERFLOW=20
# 从池中获取连接的最长等待时间（秒）
DB_POOL_TIMEOUT=30
# 连接回收时间（秒），避免超过 MySQL 的 wait_timeout 导致连接被服务端断开
DB_POOL_RECYCLE=3600
# 取连接前先探测可用性，防止拿到已断开的连接
DB_POOL_PRE_PING=true
# 是否打印 SQL（生产环境务必 false，调试时临时改 true）
DB_ECHO=false
# 建立数据库连接的超时时间（秒）
DB_CONNECT_TIMEOUT=10

# ===================== DeepSeek 大模型 =====================
# 密钥在 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 模型
DEEPSEEK_MODEL=DeepSeek-V4.1-Flash
# DeepSeek 是 OpenAI 兼容接口，base_url 指向官方地址即可
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 调用参数（生产级，可选）----
# 单次请求超时（秒），LLM 较慢建议 60-120
LLM_TIMEOUT=60
# 失败自动重试次数
LLM_MAX_RETRIES=3
# 单次输出最大 token 数
LLM_MAX_TOKENS=2048
# 采样温度，0=确定，1=更随机
LLM_TEMPERATURE=0
